            },
            {
              "id": "AwsSolutions-RDS11",
              "reason": "Port obfuscation is not meaningful defence in depth here: the instance sits in an isolated private subnet with no route to the internet, and access control is the security group, not port secrecy. A non-default port would only add friction to every tool and runbook that assumes 5432.",
            },
          ],
        },
      },
      "Properties": {
        "Description": {
          "Fn::Join": [
