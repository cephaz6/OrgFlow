{
  "name": "@orgflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@orgflow/core": "workspace:^",
    "@orgflow/db": "workspace:^",
    "@orgflow/documents": "workspace:^",
    "@orgflow/email": "workspace:^",
    "@orgflow/events": "workspace:^",
    "@orgflow/types": "workspace:^",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "kysely": "^0.29.5",
    "mongodb": "^7.5.0",
    "openid-client": "^6.8.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12"
  }
}
