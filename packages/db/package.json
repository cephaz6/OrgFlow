{
  "name": "@orgflow/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:up": "node --env-file=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -d ORGFLOW_DATABASE_URL -m migrations",
    "migrate:down": "node --env-file=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -d ORGFLOW_DATABASE_URL -m migrations",
    "migrate:create": "node-pg-migrate create -j sql -m migrations"
  },
  "dependencies": {
    "@orgflow/types": "workspace:^",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.21.0",
    "node-pg-migrate": "^9.0.0",
    "testcontainers": "^12.1.0"
  }
}
