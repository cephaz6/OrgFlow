# OrgFlow local development configuration.
#
# This file lists every variable the application reads and what it is for.
# It carries no values, not even non-secret local ones, so there is never
# anything here to accidentally treat as a real setting. Copy it to .env and
# fill in real values as you provision them.
#
# Every variable below is validated once at startup. If one is missing or
# malformed, the application refuses to boot and names it. There is no silent
# fallback and no default injected at the point of use.
#
# .env is gitignored and must never be committed, logged or pasted anywhere.
# In a deployed environment this file is not used at all; configuration and
# secrets come from AWS Secrets Manager and Parameter Store.

# --- Runtime -----------------------------------------------------------------
# ORGFLOW_ENV gates the seeded development login. That path fails closed, so it
# cannot be enabled anywhere other than local.
ORGFLOW_ENV=
ORGFLOW_API_PORT=
ORGFLOW_WEB_URL=
ORGFLOW_LOG_LEVEL=

# --- Datastores --------------------------------------------------------------
# Point these at the Docker Compose containers defined in docker-compose.yml.
# Never point these at a shared or deployed database.
ORGFLOW_DATABASE_URL=
ORGFLOW_MONGODB_URI=

# --- Session -----------------------------------------------------------------
# Signs the session cookie. Generate your own and keep it out of version control:
#   openssl rand -hex 32
# This value is load-bearing. Changing it invalidates every existing session and
# signs every user out.
ORGFLOW_SESSION_SECRET=

# --- AWS ---------------------------------------------------------------------
# ORGFLOW_AWS_ENDPOINT points at LocalStack locally. Leave it unset in a deployed
# environment so the SDK resolves the real service endpoints.
ORGFLOW_AWS_REGION=
ORGFLOW_AWS_ENDPOINT=
ORGFLOW_S3_BUCKET=
ORGFLOW_EVENTS_TOPIC_ARN=

# --- Notification worker -----------------------------------------------------
# The SQS queue subscribed to the events topic. Read by workers/ only; leave it
# blank and the worker exits rather than idling against nothing.
ORGFLOW_NOTIFICATIONS_QUEUE_URL=
# The verified SES sender address. Leave it blank to use the dummy sender, which
# records what it would have sent and delivers nothing.
ORGFLOW_SES_FROM_ADDRESS=

# --- Identity provider -------------------------------------------------------
# Optional locally. Leave blank to use the seeded development login instead.
# To exercise the real flow, register an OAuth client in the Google Cloud console
# and set the redirect URI to http://localhost:4000/api/v1/auth/callback.
# The client secret belongs here only on your own machine; deployed environments
# read it from Secrets Manager.
ORGFLOW_OIDC_ISSUER_URL=
ORGFLOW_OIDC_CLIENT_ID=
ORGFLOW_OIDC_CLIENT_SECRET=

# --- Browser-exposed ---------------------------------------------------------
# Next.js requires the NEXT_PUBLIC_ prefix for anything reaching the client.
# Nothing secret may ever carry this prefix. Add variables here one at a time,
# deliberately; never spread the environment into client code.
NEXT_PUBLIC_ORGFLOW_API_URL=
